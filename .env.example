# Copy to .env and fill in values from your Supabase project (Settings → API).

# Server (SSR, server functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lovable AI Gateway (server-only, for review scoring)
LOVABLE_API_KEY=

# Optional: default manager/junior ids are seeded in migration

# Client (Vite — exposed to the browser; use anon/publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ElevenLabs conversational agent (client — in-browser case review)
VITE_ELEVENLABS_AGENT_ID=

# --- ElevenLabs outbound phone (backend/ + in-app case phone review) ---
# See backend/README.md — Twilio + ElevenLabs outbound phone calls
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Alias accepted by in-app phone review (src/lib/phone.functions.ts)
ELEVENLABS_PHONE_NUMBER_ID=
# E.164 outbound destination for case phone review (no spaces), e.g. +49157393997440
REVIEW_PHONE_TO_NUMBER=
ELEVENLABS_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
DEMO_MODE=true
CHECK_IN_INTERVAL_DAYS=14
