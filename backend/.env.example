# Supabase (service role — server only, never expose to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs — work check-in agent + imported Twilio number
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# dashboard (default) | demo | full — see backend/README.md
ELEVENLABS_PROMPT_MODE=dashboard

# Public URL for post-call webhooks (ngrok in dev)
PUBLIC_BASE_URL=http://localhost:8000

# true = allow trigger without waiting 14 days (good for buildathon demo)
DEMO_MODE=true
CHECK_IN_INTERVAL_DAYS=14
